@startuml cosmoscan-architecture
!pragma layout smetana

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Segoe UI
skinparam roundcorner 8

title CosmoScan - system architecture

actor "User\n(browser)" as user

package "Portal" #E8F4F8 {
  [web-ui\n:8094\nnginx] as ui
}

package "API Gateway" #E8EAF6 {
  [API Gateway\n:8090\nSpring Cloud Gateway] as gw
}

package "Microservices" #E8F5E9 {
  [submission-service\n:8091\nPOST /works] as sub
  [file-storing-service\n:8092\nPOST/GET /files] as fs
  [analysis-service\n:8093\nreports, word cloud] as ana
}

database "PostgreSQL\n:5433\nworks" as subdb
database "PostgreSQL\n:5434\nreports, word cloud" as anadb
storage "Disk\nwork files" as fsdisk
storage "Disk\nreport JSON" as rptdisk

user --> ui : opens the portal
ui --> gw : fetch API\n(POST /works, GET ...)
user --> gw : Swagger

gw --> sub : POST /works
gw --> fs : POST/GET /files
gw --> ana : GET /works/{id}/reports\nGET /works/{id}/word-cloud

sub --> subdb
sub --> fs : POST /files\nDELETE /internal/files/{id}\n(on failed submit)
sub ..> ana : POST /internal/analysis\n(not via gateway)

ana --> anadb
ana --> fs : GET /files/{id}
ana --> rptdisk
fs --> fsdisk

note right of gw
  Internal calls
  /internal/analysis and
  /internal/files/{id}
  are not routed by the gateway
end note

@enduml
