@startuml cosmoscan-uc1-sequence

skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam defaultFontName Segoe UI

title UC-1 - Submit work (POST /works)

actor "User" as user
participant "web-ui\n:8094" as ui
participant "Gateway\n:8090" as gw
participant "submission\n:8091" as sub
participant "file-storing\n:8092" as fs
participant "analysis\n:8093" as ana

user -> ui : full name + file
ui -> gw : POST /works (multipart)
gw -> sub : POST /works
sub -> fs : POST /files
fs --> sub : fileId
sub -> sub : save Work
sub -> ana : POST /internal/analysis
ana -> fs : GET /files/{fileId}
ana -> ana : technical check +\nword cloud (Tika)
ana --> sub : TechnicalReport
alt analysis or save failed
  sub -> fs : DELETE /internal/files/{fileId}
  sub --> gw : 4xx/5xx (work rolled back)
else success
  sub --> gw : WorkResponse (id)
  gw --> ui : 201 Created
  ui --> user : id, technicalReport
end

@enduml
